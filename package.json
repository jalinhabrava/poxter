{
  "name": "poxter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:poxter": "bash scripts/dev/poxter-dev.sh",
    "mcp:poxter": "bash scripts/mcp/poxter-mcp.sh",
    "onboard:bootstrap": "bash scripts/onboarding/bootstrap.sh",
    "onboard": "bash scripts/onboarding/run.sh",
    "check:poxter": "bash scripts/dev/poxter-check.sh",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.mjs",
    "test:ci": "POXTER_BRANDS_FILE=$PWD/tests/fixtures/brands.test.json DATABASE_URL=file:$PWD/test.db pnpm prisma db push --skip-generate && POXTER_BRANDS_FILE=$PWD/tests/fixtures/brands.test.json DATABASE_URL=file:$PWD/test.db vitest run",
    "test": "DATABASE_URL=file:$PWD/test.db pnpm prisma db push --skip-generate && DATABASE_URL=file:$PWD/test.db vitest run",
    "build": "next build",
    "prisma": "node scripts/dev/prisma-wrapper.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@prisma/client": "^5.22.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
