# Local SQLite database used by Prisma.
DATABASE_URL="file:/absolute/path/to/poxter/dev.db"

# Bind address for local dev server.
POXTER_HOST="0.0.0.0"

# Port for local dev server.
POXTER_PORT="3000"

# Optional Buffer token. Leave empty unless you need live Buffer actions.
BUFFER_API_KEY=""

# Optional path to a private brand registry file.
POXTER_BRANDS_FILE=""
