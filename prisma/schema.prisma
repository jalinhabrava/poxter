generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  sourceItems SourceItem[]
  drafts      Draft[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SourceItem {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  externalId String?
  kind       String?
  payload    String?
  createdAt DateTime @default(now())
}

model Draft {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  externalId String   @unique
  slotId     String
  platform   String
  format     String
  title      String
  body       String?
  threadPosts String?
  status     String
  sourceContext String?
  scheduleMeta String?
  scheduledAt DateTime?
  importedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SafetyWarning {
  id        String   @id @default(cuid())
  draftId   String?
  brandId   String?
  message   String
  payload   String?
  createdAt DateTime @default(now())
}

model BufferChannelMapping {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model BufferChannelCache {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model ScheduledPost {
  id             String   @id @default(cuid())
  brandSlug      String
  draftId        String?
  title          String
  body           String
  scheduledAt    DateTime
  externalStatus String
  payload        String?
  createdAt      DateTime @default(now())
}

model PublishActionLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
